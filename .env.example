# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
# ALLOWED_HOSTS: daftar host dipisah koma. Contoh:
#   Lokal:          localhost,127.0.0.1
#   VPS:            yourdomain.com,www.yourdomain.com,65.108.x.x
#   Shared hosting: yourdomain.com
#   Vercel:         .vercel.app,yourdomain.com  (Vercel auto-append .vercel.app bila VERCEL=1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Gemini Settings (Required for AI features)
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
FREE_MONTHLY_DOCUMENT_LIMIT=5

# Database
# Kosongkan untuk SQLite di development (DEBUG=True). Di produksi (DEBUG=False) WAJIB diisi:
#   MySQL (VPS/shared hosting):  mysql://user:password@db-host:3306/nama_database
#   Postgres (Supabase/Vercel):  postgres://user:password@db-host:5432/postgres?sslmode=require
#   Engine dipilih otomatis dari skema URL oleh dj-database-url.
DATABASE_URL=

# Hosting proxy (set True bila di belakang Nginx/Cloudflare/Vercel agar OAuth redirect jadi https://)
# BEHIND_PROXY=True

# CSRF: wajib diisi saat produksi dengan HTTPS (pisah koma, harus pakai https://)
# Contoh: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Untuk Vercel preview, otomatis pakai VERCEL_URL jadi tidak wajib set manual.
# CSRF_TRUSTED_ORIGINS=

# Supabase Auth Settings (Optional, for Google/GitHub OAuth logins)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_CLIENT_ID=your-google-oauth-client-id-here
SUPABASE_GITHUB_CLIENT_ID=your-github-oauth-client-id-here
