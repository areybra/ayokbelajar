# Django Core Settings
SECRET_KEY=your-django-secret-key-here
DEBUG=True
# ALLOWED_HOSTS: daftar host dipisah koma. Contoh:
#   Lokal:          localhost,127.0.0.1
#   VPS:            yourdomain.com,www.yourdomain.com,65.108.x.x
#   Shared hosting: yourdomain.com
#   Vercel:         .vercel.app,yourdomain.com  (Vercel auto-append .vercel.app bila VERCEL=1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Google Gemini Settings (Required for AI features)
GOOGLE_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
FREE_MONTHLY_DOCUMENT_LIMIT=5

# Database
# Kosongkan untuk SQLite di development (DEBUG=True). Di produksi (DEBUG=False) WAJIB diisi MySQL:
#   DATABASE_URL=mysql://user:password@db-host:3306/nama_database
# Contoh shared hosting / VPS: DATABASE_URL=mysql://ayokbelajar_user:password@localhost:3306/ayokbelajar_db
# Khusus MySQL yang mewajibkan SSL (mis. PlanetScale), tambah ?ssl-ca= :
#   DATABASE_URL=mysql://user:pass@host:3306/db?ssl-ca=/etc/ssl/certs/ca-certificates.crt
# JANGAN pakai ?sslmode= (itu sintaks Postgres — menyebabkan 500 di driver MySQL).
DATABASE_URL=

# Hosting proxy (set True bila di belakang Nginx/Cloudflare agar request.is_secure() benar)
# BEHIND_PROXY=True

# CSRF: wajib diisi saat produksi dengan HTTPS (pisah koma, harus pakai https://)
# Contoh: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# CSRF_TRUSTED_ORIGINS=
